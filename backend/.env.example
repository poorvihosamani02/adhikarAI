# =============================================================================
# AdhikarAI Backend — Environment Variables Configuration Template
# Copy this file to backend/.env and replace placeholders with your local settings.
# NEVER commit your active .env file containing real secrets to version control.
# =============================================================================

# Server Gateway Port (default: 3000)
PORT=3000

# Frontend URL (optional, for custom production or alternative development origin)
# Defaults allowed: http://localhost:5173, http://127.0.0.1:5173, http://localhost:4173, http://127.0.0.1:4173
FRONTEND_URL=http://localhost:5173

# JSON Web Token Secret Key
# REQUIRED: Must be a strong, unpredictable random string (at least 32 characters).
# The backend will refuse to start if this is missing, empty, or set to 'secret_key'.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# Python AI Microservice Endpoints
# Port 8001: RAG Chatbot Service
RAG_SERVICE_URL=http://127.0.0.1:8001

# Port 8002: Document Doctor Service
DOC_DOCTOR_SERVICE_URL=http://127.0.0.1:8002

# Port 8003: Scam Shield Service
SCAM_SERVICE_URL=http://127.0.0.1:8003
